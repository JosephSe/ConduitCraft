    "simulations": [
      {
        "id": "sim-mesh-request",
        "name": "Request Through Ingress and Mesh",
        "tone": "blue",
        "budgetMs": 80,
        "steps": [
          {
            "id": "m1",
            "nodes": [
              "users",
              "cloud-lb"
            ],
            "tone": "blue",
            "label": "HTTPS",
            "trace": "The request reaches the cloud load balancer."
          },
          {
            "id": "m2",
            "nodes": [
              "cloud-lb",
              "ingress"
            ],
            "tone": "violet",
            "label": "TLS + ROUTE",
            "trace": "An Envoy gateway pod terminates TLS and matches the host and path."
          },
          {
            "id": "m3",
            "nodes": [
              "ingress",
              "web"
            ],
            "tone": "blue",
            "label": "mTLS",
            "trace": "The gateway forwards to a web pod; the sidecars verify each other's certificates."
          },
          {
            "id": "m4",
            "nodes": [
              "web",
              "coredns"
            ],
            "tone": "blue",
            "label": "DNS",
            "trace": "web resolves api.prod.svc.cluster.local (usually from cache)."
          },
          {
            "id": "m5",
            "nodes": [
              "web",
              "api"
            ],
            "tone": "blue",
            "label": "gRPC",
            "trace": "web calls the API pod to pod over mutual TLS."
          },
          {
            "id": "m6",
            "nodes": [
              "api",
              "postgres"
            ],
            "tone": "emerald",
            "label": "SQL",
            "trace": "The API queries the Postgres primary."
          },
          {
            "id": "m7",
            "nodes": [
              "postgres",
              "volumes"
            ],
            "tone": "emerald",
            "label": "DISK",
            "trace": "Postgres reads pages from its Ceph volume."
          },
          {
            "id": "m8",
            "nodes": [
              "api",
              "web",
              "ingress",
              "cloud-lb",
              "users"
            ],
            "tone": "emerald",
            "label": "200 OK",
            "trace": "The page goes back out the same way."
          }
        ]
      },
      {
        "id": "sim-pod-crash",
        "name": "API Pod Crash (Self-Healing)",
        "tone": "amber",
        "failures": [
          "api"
        ],
        "steps": [
          {
            "id": "c1",
            "nodes": [
              "users",
              "cloud-lb",
              "ingress"
            ],
            "tone": "blue",
            "label": "TRAFFIC",
            "trace": "Requests keep arriving while one API pod is OOM-killed."
          },
          {
            "id": "c2",
            "nodes": [
              "ingress",
              "api"
            ],
            "tone": "amber",
            "label": "DEGRADED",
            "trace": "The pod fails its readiness probe and leaves the Service endpoints; the other replicas take its share."
          },
          {
            "id": "c3",
            "nodes": [
              "api",
              "postgres"
            ],
            "tone": "emerald",
            "label": "STILL SERVING",
            "trace": "Requests carry on. The ReplicaSet starts a replacement pod in seconds."
          }
        ]
      },
      {
        "id": "sim-backup",
        "name": "Nightly Database Backup",
        "tone": "amber",
        "steps": [
          {
            "id": "b1",
            "nodes": [
              "cronjob",
              "backup-job"
            ],
            "tone": "amber",
            "label": "03:00",
            "trace": "The CronJob creates a Job; its pod is scheduled on any free node."
          },
          {
            "id": "b2",
            "nodes": [
              "backup-job",
              "postgres"
            ],
            "tone": "amber",
            "label": "pg_dump",
            "trace": "The dump reads from the standby so the primary is not slowed down."
          },
          {
            "id": "b3",
            "nodes": [
              "backup-job",
              "object-store"
            ],
            "tone": "emerald",
            "label": "UPLOADED",
            "trace": "The compressed dump goes to the backups bucket. The Job exits and its pod is cleaned up."
          }
        ]
      }
