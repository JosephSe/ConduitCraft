        "code": "SPEC-EDA",
        "x": 48,
        "y": 930,
        "items": [
          {
            "title": "Transactional outbox",
            "text": "Order and event commit together; none is lost.",
            "icon": "check"
          },
          {
            "title": "Idempotent consumers",
            "text": "At-least-once delivery: dedupe on event id.",
            "icon": "check"
          },
          {
            "title": "Saga, not 2PC",
            "text": "PaymentFailed triggers a compensating cancel.",
            "icon": "info"
          },
          {
            "title": "Eventual consistency",
            "text": "The read model trails writes by ~200 ms.",
            "icon": "warning"
          }
        ]
      }
    ],
