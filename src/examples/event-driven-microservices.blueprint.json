    "simulations": [
      {
        "id": "sim-order-saga",
        "name": "Order Placed → Paid → Shipped",
        "tone": "amber",
        "steps": [
          {
            "id": "o1",
            "nodes": [
              "clients",
              "api-gw"
            ],
            "tone": "blue",
            "label": "POST /orders",
            "trace": "The shopper places an order. The gateway checks the token."
          },
          {
            "id": "o2",
            "nodes": [
              "api-gw",
              "order-svc"
            ],
            "tone": "blue",
            "label": "COMMAND",
            "trace": "The gateway routes the command to the Order Service."
          },
          {
            "id": "o3",
            "nodes": [
              "order-svc",
              "orders-db"
            ],
            "tone": "emerald",
            "label": "COMMIT + OUTBOX",
            "trace": "The order and an OrderPlaced outbox row commit in one transaction. The client gets 202 Accepted now."
          },
          {
            "id": "o4",
            "nodes": [
              "order-svc",
              "event-stream"
            ],
            "tone": "amber",
            "label": "OrderPlaced",
            "trace": "The outbox relay publishes the event to Kafka, keyed by order id."
          },
          {
            "id": "o5",
            "nodes": [
              "event-stream",
              "payment-svc"
            ],
            "tone": "amber",
            "label": "CONSUME",
            "trace": "The payment consumer group reads OrderPlaced."
          },
          {
            "id": "o6",
            "nodes": [
              "payment-svc",
              "payment-provider"
            ],
            "tone": "violet",
            "label": "CHARGE",
            "trace": "The card is charged with the order id as the idempotency key, so a retry never charges twice."
          },
          {
            "id": "o7",
            "nodes": [
              "payment-svc",
              "event-stream"
            ],
            "tone": "amber",
            "label": "PaymentCaptured",
            "trace": "Payment succeeded; the service publishes PaymentCaptured."
          },
          {
            "id": "o8",
            "nodes": [
              "event-stream",
              "fulfilment-queue"
            ],
            "tone": "amber",
            "label": "ShipOrder",
            "trace": "A ShipOrder job is queued for the fulfilment workers."
          },
          {
            "id": "o9",
            "nodes": [
              "fulfilment-queue",
              "fulfilment-svc"
            ],
            "tone": "amber",
            "label": "SHIP",
            "trace": "A worker takes the job, books the courier and publishes OrderShipped."
          },
          {
            "id": "o10",
            "nodes": [
              "event-stream",
              "notify-svc",
              "query-svc"
            ],
            "tone": "emerald",
            "label": "FAN-OUT",
            "trace": "Every event also reaches notifications (receipt email) and the read model (status: shipped)."
          }
        ]
      },
      {
        "id": "sim-payment-declined",
        "name": "Payment Declined (Compensating Saga)",
        "tone": "rose",
        "steps": [
          {
            "id": "p1",
            "nodes": [
              "event-stream",
              "payment-svc"
            ],
            "tone": "amber",
            "label": "OrderPlaced",
            "trace": "The payment consumer reads a new order."
          },
          {
            "id": "p2",
            "nodes": [
              "payment-svc",
              "payment-provider"
            ],
            "tone": "rose",
            "label": "DECLINED",
            "trace": "The provider declines the card."
          },
          {
            "id": "p3",
            "nodes": [
              "payment-svc",
              "event-stream"
            ],
            "tone": "rose",
            "label": "PaymentFailed",
            "trace": "The service publishes PaymentFailed instead of PaymentCaptured."
          },
          {
            "id": "p4",
            "nodes": [
              "event-stream",
              "order-svc"
            ],
            "tone": "rose",
            "label": "COMPENSATE",
            "trace": "The Order Service consumes PaymentFailed and runs the compensating action."
          },
          {
            "id": "p5",
            "nodes": [
              "order-svc",
              "orders-db"
            ],
            "tone": "rose",
            "label": "CANCELLED",
            "trace": "The order is marked CANCELLED. No ShipOrder job was ever created."
          },
          {
            "id": "p6",
            "nodes": [
              "event-stream",
              "notify-svc",
              "query-svc"
            ],
            "tone": "emerald",
            "label": "NOTIFY",
            "trace": "The shopper is emailed and the read model shows the order as cancelled."
          }
        ]
      },
      {
        "id": "sim-read-order",
        "name": "Read Order Status (CQRS Query)",
        "tone": "emerald",
        "budgetMs": 60,
        "steps": [
          {
            "id": "q1",
            "nodes": [
              "clients",
              "api-gw"
            ],
            "tone": "blue",
            "label": "GET /orders/:id",
            "trace": "The app polls the order status."
          },
          {
            "id": "q2",
            "nodes": [
              "api-gw",
              "query-svc"
            ],
            "tone": "emerald",
            "label": "QUERY",
            "trace": "Queries go to the read side, never to the Order Service."
          },
          {
            "id": "q3",
            "nodes": [
              "query-svc",
              "read-model"
            ],
            "tone": "emerald",
            "label": "VIEW LOOKUP",
            "trace": "One document lookup returns the whole denormalised order view."
          },
          {
            "id": "q4",
            "nodes": [
              "query-svc",
              "api-gw",
              "clients"
            ],
            "tone": "emerald",
            "label": "200 OK",
            "trace": "The status comes back without touching the write database."
          }
        ]
      },
      {
        "id": "sim-fulfilment-down",
        "name": "Fulfilment down",
        "tone": "rose",
        "failures": [
          "fulfilment-svc"
        ],
        "steps": [
          {
            "id": "f1",
            "nodes": [
