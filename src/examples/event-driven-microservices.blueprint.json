        "width": 678
      },
      {
        "id": "zone-backbone",
        "number": "02",
        "title": "Event Backbone",
        "subtitle": "Kafka topic, work queue and DLQ",
        "x": 764,
        "width": 308
      },
      {
        "id": "zone-services",
        "number": "03",
        "title": "Domain Services",
        "subtitle": "Consumers that own their data",
