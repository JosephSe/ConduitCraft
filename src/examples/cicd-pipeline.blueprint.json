        "id": "notes-cicd",
        "title": "Pipeline guarantees",
        "code": "SPEC-CD",
        "x": 48,
        "y": 730,
        "items": [
          {
            "title": "Nothing skips the gate",
            "text": "Branch protection requires it.",
            "icon": "check"
          },
          {
            "title": "Build once",
            "text": "Every env runs the same signed digest.",
            "icon": "check"
          },
          {
            "title": "Git is the truth",
            "text": "Roll back with git revert; Argo undoes drift.",
            "icon": "check"
          },
          {
            "title": "Canary brake",
            "text": "Errors > 1% or p99 > 400 ms abort it.",
            "icon": "warning"
          }
        ]
      }
    ],
