    "simulations": [
      {
        "id": "sim-pr-to-prod",
        "name": "Pull Request → Production Canary",
        "tone": "emerald",
        "steps": [
          {
            "id": "c1",
            "nodes": [
              "dev",
              "repo"
            ],
            "tone": "blue",
            "label": "PUSH",
            "trace": "The developer pushes a branch and opens a pull request."
          },
          {
            "id": "c2",
            "nodes": [
              "repo",
              "ci"
            ],
            "tone": "blue",
            "label": "WEBHOOK",
            "trace": "GitHub starts the workflow on a fresh runner."
          },
          {
            "id": "c3",
            "nodes": [
              "ci",
              "tests",
              "scans"
            ],
            "tone": "emerald",
            "label": "PARALLEL CHECKS",
            "trace": "The test matrix and the security scans run at the same time."
          },
          {
            "id": "c4",
            "nodes": [
              "tests",
              "scans",
              "gate"
            ],
            "tone": "violet",
            "label": "GATE PASSES",
            "trace": "All checks are green, so the PR can merge."
          },
          {
            "id": "c5",
            "nodes": [
              "gate",
              "build"
            ],
            "tone": "blue",
            "label": "BUILD & SIGN",
            "trace": "On merge to main the image is built once, given an SBOM and signed with Cosign."
          },
          {
            "id": "c6",
            "nodes": [
              "build",
              "registry",
              "config-repo"
            ],
            "tone": "emerald",
            "label": "PUBLISH",
            "trace": "The image goes to the registry and the new digest is committed to the config repo."
          },
          {
            "id": "c7",
            "nodes": [
              "argocd",
              "config-repo"
            ],
            "tone": "amber",
            "label": "DRIFT FOUND",
            "trace": "Argo CD sees the config repo differs from the clusters."
          },
          {
            "id": "c8",
            "nodes": [
              "argocd",
              "staging"
            ],
            "tone": "blue",
            "label": "STAGING",
            "trace": "Staging syncs automatically and the smoke tests pass."
          },
          {
            "id": "c9",
            "nodes": [
              "argocd",
              "prod"
            ],
            "tone": "rose",
            "label": "CANARY 10%",
            "trace": "Production starts the rollout with 10% of traffic on the new version."
          },
          {
            "id": "c10",
            "nodes": [
              "prod",
              "metrics"
            ],
            "tone": "amber",
            "label": "ANALYSIS",
            "trace": "Error rate and p99 for the canary stay inside the limits."
          },
          {
            "id": "c11",
            "nodes": [
              "prod",
              "registry"
            ],
            "tone": "emerald",
            "label": "100% LIVE",
            "trace": "Traffic shifts to 50% then 100%; every pod runs the signed digest."
          }
        ]
      },
      {
        "id": "sim-gate-blocks",
        "name": "Quality Gate Blocks a Vulnerable Change",
        "tone": "rose",
        "steps": [
          {
            "id": "g1",
            "nodes": [
              "dev",
              "repo"
            ],
            "tone": "blue",
            "label": "PUSH",
            "trace": "A PR adds a dependency with a known critical vulnerability."
          },
          {
            "id": "g2",
            "nodes": [
              "repo",
              "ci"
            ],
            "tone": "blue",
            "label": "WEBHOOK",
            "trace": "The workflow starts."
          },
          {
            "id": "g3",
            "nodes": [
              "ci",
              "scans"
            ],
            "tone": "rose",
            "label": "CRITICAL CVE",
            "trace": "The dependency scan finds a critical vulnerability."
          },
          {
            "id": "g4",
            "nodes": [
              "scans",
              "gate"
            ],
            "tone": "rose",
            "label": "GATE FAILS",
            "trace": "The required check fails and the PR cannot merge. No image is built and nothing deploys."
          }
        ]
      },
      {
        "id": "sim-canary-rollback",
        "name": "Canary Fails → Automatic Rollback",
        "tone": "amber",
        "steps": [
          {
            "id": "k1",
            "nodes": [
              "argocd",
              "prod"
            ],
            "tone": "rose",
            "label": "CANARY 10%",
            "trace": "A new version takes 10% of production traffic."
          },
          {
            "id": "k2",
            "nodes": [
              "prod",
              "metrics"
            ],
            "tone": "rose",
            "label": "ERROR RATE 4%",
            "trace": "Analysis finds a 4% error rate on the canary against a 1% limit."
          },
          {
            "id": "k3",
            "nodes": [
              "argocd",
              "prod"
            ],
            "tone": "amber",
            "label": "ABORT",
            "trace": "Argo Rollouts aborts and sends all traffic back to the stable version. Users saw errors on 10% of requests for one step only."
          },
          {
            "id": "k4",
            "nodes": [
              "argocd",
              "config-repo"
            ],
            "tone": "amber",
            "label": "REVERT",
            "trace": "The team reverts the digest commit so git matches what is running."
          }
        ]
      }
    ]
