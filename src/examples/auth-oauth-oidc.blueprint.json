      {
        "id": "billing-api",
        "kind": "service",
        "accent": "rose",
        "icon": "box",
        "shape": "card",
        "title": "Billing & Payments API",
        "subtitle": "PCI DSS Scoped Microservice",
        "eyebrow": "RESOURCE: BILLING",
        "chip": "Scope: write:orders",
        "zoneLabel": "Resource Servers",
        "summary": "Processes customer credit subscriptions, invoicing, and PCI payment method tokenization.",
        "metrics": [
          { "label": "RPS", "value": "1.2k" },
          { "label": "Latency", "value": "24ms" }
