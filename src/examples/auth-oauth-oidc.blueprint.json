      },
      {
        "id": "e5",
        "from": "auth-server",
        "to": "api-gw",
        "sourcePort": "right",
        "targetPort": "top",
        "tone": "violet",
        "route": "bezier",
        "label": "JWKS Public Keys Cache",
        "animated": false
      },
      {
        "id": "e6",
        "from": "api-gw",
        "to": "user-service",
        "sourcePort": "right",
        "targetPort": "left",
        "tone": "emerald",
        "route": "bezier",
