    "simulations": [
      {
        "id": "sim-pkce-flow",
        "name": "PKCE Code Exchange & Token Mint",
        "tone": "violet",
        "steps": [
          {
            "id": "a1",
            "nodes": ["spa-client", "auth-server"],
            "tone": "violet",
            "label": "AUTH CODE CHALLENGE",
            "trace": "Client launches PKCE login; sends SHA-256 code challenge to /authorize."
