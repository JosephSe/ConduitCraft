      "name": "AuthShield Identity",
      "accent": "#7c3aed",
      "logo": ""
    },
    "zones": [
      {
        "id": "zone-client",
        "number": "01",
        "title": "Client User Agent",
        "subtitle": "Browser and single-page application",
        "x": 24,
        "width": 360
      },
      {
        "id": "zone-idp",
        "number": "02",
        "title": "Identity Provider (IdP)",
        "subtitle": "Authorization server & key vault",
        "x": 414,
        "width": 460
      },
      {
        "id": "zone-apis",
        "number": "03",
        "title": "Resource Servers",
        "subtitle": "Protected API gateway & microservices",
        "x": 904,
        "width": 740
