      {
        "id": "notes-security",
        "title": "Zero-Trust Security Controls",
        "code": "OIDC-21",
        "x": 48,
        "y": 680,
        "items": [
          {
            "title": "PKCE Enforcement",
            "text": "Code challenge (S256) is mandatory; client secrets are never embedded in the browser."
          },
          {
            "title": "Short-Lived Access Tokens",
            "text": "JWT access tokens expire after 15 minutes; rotating refresh tokens stored in HTTP-only cookies."
          },
          {
            "title": "JWKS Verification",
            "text": "Resource servers cache and verify RS256 signatures via public /.well-known/jwks.json."
          }
        ]
      }
    ],
