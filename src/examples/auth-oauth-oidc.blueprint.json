          {
            "id": "a2",
            "nodes": ["auth-server", "kms-vault"],
            "tone": "amber",
            "label": "CRYPTO SIGNING",
            "trace": "Authorization server requests private RS256 key from HSM vault to sign JWT claims."
          },
          {
            "id": "a3",
            "nodes": ["auth-server", "spa-client"],
            "tone": "emerald",
            "label": "TOKEN ISSUED",
            "trace": "Access token and ID token issued and stored securely in browser memory."
          },
          {
            "id": "a4",
            "nodes": ["spa-client", "api-gw"],
            "tone": "blue",
            "label": "BEARER REQUEST",
            "trace": "SPA attaches Bearer JWT in Authorization header to invoke protected API."
          },
          {
            "id": "a5",
            "nodes": ["api-gw", "user-service"],
            "tone": "emerald",
            "label": "CLAIMS FORWARDED",
            "trace": "Gateway validates JWT cryptographic signature and forwards verified user identity."
