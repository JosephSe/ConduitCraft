        "animated": true
      },
      {
        "id": "e7",
        "from": "api-gw",
        "to": "billing-api",
        "sourcePort": "right",
        "targetPort": "left",
        "tone": "rose",
        "route": "bezier",
        "label": "Forward with X-User-Id",
        "animated": true
      }
