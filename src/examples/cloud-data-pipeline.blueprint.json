    "simulations": [
      {
        "id": "sim-live-telemetry",
        "name": "Live Telemetry → Dashboard",
        "tone": "amber",
        "budgetMs": 10000,
        "steps": [
          {
            "id": "t1",
            "nodes": [
              "iot",
              "stream"
            ],
            "tone": "blue",
            "label": "PutRecords",
            "trace": "A device batch arrives at Kinesis, keyed by device id."
          },
          {
            "id": "t2",
            "nodes": [
              "stream",
              "bronze",
              "spark"
            ],
            "tone": "amber",
            "label": "FAN-OUT",
            "trace": "Firehose lands the raw records in bronze; Spark reads the same records from its own position."
          },
          {
            "id": "t3",
            "nodes": [
              "spark",
              "silver"
            ],
            "tone": "emerald",
            "label": "SILVER",
            "trace": "Duplicates are dropped and the clean rows MERGE into the silver Delta table."
          },
          {
            "id": "t4",
            "nodes": [
              "spark",
              "warehouse"
            ],
            "tone": "emerald",
            "label": "LIVE AGGREGATE",
            "trace": "The 1-minute window closes and its aggregate is written to ClickHouse."
          },
          {
            "id": "t5",
            "nodes": [
              "bi",
              "warehouse"
            ],
            "tone": "blue",
            "label": "FRESH IN ~6 s",
            "trace": "The live dashboard refresh picks up the new minute."
          }
        ]
      },
      {
        "id": "sim-nightly-elt",
        "name": "Nightly ELT (dbt Run)",
        "tone": "violet",
        "steps": [
          {
            "id": "n1",
            "nodes": [
              "saas",
              "bronze"
            ],
            "tone": "violet",
            "label": "HOURLY SYNC",
            "trace": "CRM, billing and database changes have landed in bronze during the day."
          },
          {
            "id": "n2",
            "nodes": [
              "airflow",
              "dbt"
            ],
            "tone": "blue",
            "label": "02:00 TRIGGER",
            "trace": "Airflow starts the dbt DAG."
          },
          {
            "id": "n3",
            "nodes": [
              "dbt",
              "bronze",
              "silver"
            ],
            "tone": "emerald",
            "label": "READ",
            "trace": "dbt reads changed partitions from bronze and silver."
          },
          {
            "id": "n4",
            "nodes": [
              "dbt",
              "warehouse"
            ],
            "tone": "violet",
            "label": "BUILD GOLD",
            "trace": "Incremental models rebuild the gold marts; data tests run before the swap."
          },
          {
            "id": "n5",
            "nodes": [
              "bi",
              "warehouse"
            ],
            "tone": "blue",
            "label": "MORNING REPORTS",
            "trace": "Dashboards show yesterday complete and reconciled."
          }
        ]
      },
      {
        "id": "sim-spark-down",
        "name": "Stream Processor Down",
        "tone": "rose",
        "failures": [
          "spark"
        ],
        "steps": [
          {
            "id": "d1",
            "nodes": [
              "iot",
              "stream"
            ],
            "tone": "blue",
            "label": "STILL INGESTING",
            "trace": "Devices keep sending; nothing is rejected."
          },
          {
            "id": "d2",
            "nodes": [
              "stream",
              "bronze"
            ],
            "tone": "amber",
            "label": "RAW STILL LANDS",
            "trace": "Firehose reads independently, so bronze stays complete."
          },
          {
            "id": "d3",
            "nodes": [
              "stream",
              "spark"
            ],
            "tone": "rose",
            "label": "BACKLOG",
            "trace": "Spark is down. Its records wait in the stream for up to 24 hours and are processed from the saved checkpoint on restart."
          }
        ]
