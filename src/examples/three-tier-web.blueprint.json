{
  "kind": "conduitcraft.blueprint",
  "version": 1,
  "document": {
    "direction": "LR",
    "stageWidth": 1680,
    "stageHeight": 920,
    "title": "Three-Tier Web Application",
    "systemTag": "WEB PLATFORM // MULTI-AZ",
    "statusLabel": "REFERENCE ARCHITECTURE",
    "overviewSummary": "The classic presentation, application and data split. A CDN with a WAF serves static files from object storage and forwards dynamic requests to a load balancer, which spreads them over stateless app servers in two availability zones. Reads go through a Redis cache to a read replica; writes go to the PostgreSQL primary, which streams its WAL to the replica and fails over to it.",
    "brand": {
      "name": "Web Platform",
      "accent": "#2563eb",
      "logo": ""
    },
    "zones": [
      {
        "id": "zone-presentation",
        "number": "01",
        "title": "Presentation Tier",
        "subtitle": "Users, CDN and static files",
        "x": 24,
        "width": 678
      },
      {
        "id": "zone-application",
        "number": "02",
        "title": "Application Tier",
        "subtitle": "Balancer and stateless app servers",
        "x": 764,
        "width": 678
      },
      {
        "id": "zone-data",
        "number": "03",
        "title": "Data Tier",
        "subtitle": "Cache, primary and replica",
        "x": 1504,
        "width": 678
      }
    ],
    "notesCards": [
      {
        "id": "notes-three-tier",
        "title": "Why it scales",
        "code": "SPEC-3T",
        "x": 48,
        "y": 730,
        "items": [
          {
            "title": "Stateless app tier",
            "text": "Sessions live in Redis; any server takes any request.",
            "icon": "check"
          },
          {
            "title": "Static files skip the app",
            "text": "The CDN serves them straight from the bucket.",
            "icon": "check"
          },
          {
            "title": "Reads vs writes",
            "text": "Reads: Redis, then the replica. Writes: primary only.",
            "icon": "check"
          },
          {
            "title": "Replica lag",
            "text": "Read your own writes from the primary.",
            "icon": "warning"
          }
        ]
      }
    ],
