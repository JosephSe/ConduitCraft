    "simulations": [
      {
        "id": "sim-page-load",
        "name": "Page Load (Cache Hit or Miss)",
        "tone": "emerald",
        "budgetMs": 100,
        "steps": [
          {
            "id": "r1",
            "nodes": [
              "users",
              "cdn"
            ],
            "tone": "blue",
            "label": "HTTPS",
            "trace": "The browser asks for /dashboard. The CDN terminates TLS at the nearest edge."
          },
          {
            "id": "r2",
            "nodes": [
              "cdn",
              "alb"
            ],
            "tone": "violet",
            "label": "FORWARD",
            "trace": "The page is dynamic, so the CDN forwards it to the load balancer."
          },
          {
            "id": "r3",
            "nodes": [
              "alb",
              "app-a"
            ],
            "tone": "blue",
            "label": "LEAST CONN",
            "trace": "The balancer picks the app server with the fewest open connections."
          },
          {
            "id": "r4",
            "nodes": [
              "app-a",
              "cache"
            ],
            "tone": "amber",
            "label": "CACHE LOOKUP",
            "trace": "The app reads the session and the dashboard data from Redis."
          },
          {
            "id": "r5",
            "nodes": [
              "cache",
              "pg-replica"
            ],
            "tone": "emerald",
            "label": "MISS → REPLICA",
            "trace": "On a miss Redis reads through to the replica and keeps the result. On a hit this step is skipped."
          },
          {
            "id": "r6",
            "nodes": [
              "app-a",
              "alb",
              "cdn",
              "users"
            ],
            "tone": "emerald",
            "label": "200 OK",
            "trace": "The rendered page goes back through the balancer and the edge to the browser."
          }
        ]
      },
      {
        "id": "sim-checkout",
        "name": "Checkout (Write Transaction)",
        "tone": "rose",
        "budgetMs": 120,
        "steps": [
          {
            "id": "w1",
            "nodes": [
              "users",
              "cdn"
            ],
            "tone": "blue",
            "label": "POST /checkout",
            "trace": "The shopper submits the cart."
          },
          {
            "id": "w2",
            "nodes": [
              "cdn",
              "alb"
            ],
            "tone": "violet",
            "label": "FORWARD",
            "trace": "POST requests are never cached at the edge."
          },
          {
            "id": "w3",
            "nodes": [
              "alb",
              "app-b"
            ],
            "tone": "blue",
            "label": "ROUTE",
            "trace": "The balancer sends this one to the AZ-b server."
          },
          {
            "id": "w4",
            "nodes": [
              "app-b",
              "pg-primary"
            ],
            "tone": "rose",
            "label": "COMMIT",
            "trace": "The order and the stock change commit in one transaction on the primary."
          },
          {
            "id": "w5",
            "nodes": [
              "pg-primary",
              "pg-replica"
            ],
            "tone": "rose",
            "label": "WAL → REPLICA",
            "trace": "The primary streams the change to the replica a few ms later. The shopper does not wait for it."
          },
          {
            "id": "w6",
            "nodes": [
              "app-b",
              "alb",
              "cdn",
              "users"
            ],
            "tone": "emerald",
            "label": "201 CREATED",
            "trace": "The order confirmation goes back to the browser."
          }
        ]
      },
      {
        "id": "sim-az-outage",
        "name": "Availability Zone Outage",
        "tone": "amber",
        "failures": [
          "app-a"
        ],
        "steps": [
          {
            "id": "z1",
            "nodes": [
              "users",
              "cdn"
            ],
            "tone": "blue",
            "label": "HTTPS",
            "trace": "Traffic arrives as normal while AZ-a is down."
          },
          {
            "id": "z2",
            "nodes": [
              "cdn",
              "alb"
            ],
            "tone": "violet",
            "label": "FORWARD",
            "trace": "The edge forwards to the balancer."
          },
          {
            "id": "z3",
            "nodes": [
              "alb",
              "app-a"
            ],
            "tone": "amber",
            "label": "REROUTE",
            "trace": "AZ-a fails its health check, so the balancer sends the request to AZ-b instead."
          },
          {
            "id": "z4",
            "nodes": [
              "app-a",
              "cache"
            ],
            "tone": "amber",
            "label": "CACHE LOOKUP",
            "trace": "The surviving server reads from the same shared cache; no session is lost."
          },
          {
            "id": "z5",
            "nodes": [
              "app-a",
              "alb",
              "cdn",
              "users"
            ],
            "tone": "emerald",
            "label": "200 OK",
            "trace": "Users see a normal response. Capacity is halved until AZ-a recovers."
          }
        ]
      }
    ]
  }
}
