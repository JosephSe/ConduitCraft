      {
        "id": "pg-primary",
        "kind": "store",
        "accent": "rose",
        "icon": "database",
        "title": "PostgreSQL Primary",
        "subtitle": "All writes",
        "eyebrow": "DATABASE",
        "chip": "PRIMARY",
        "zoneLabel": "Data Tier",
        "summary": "Takes every INSERT, UPDATE and DELETE and streams its write-ahead log to the replica. If it fails, the replica is promoted.",
        "metrics": [
