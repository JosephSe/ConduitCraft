<mxfile host="app.diagrams.net">
  <diagram id="p1" name="Orders">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="user" value="Customer" style="shape=umlActor;verticalLabelPosition=bottom;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="30" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API&lt;br&gt;Gateway&lt;div&gt;Routes requests&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="240" y="120" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="Orders DB" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="80" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="check" value="Fraud?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="300" width="120" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="HTTPS" style="endArrow=classic;html=1;" edge="1" parent="1" source="user" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1" source="api" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2label" value="SQL" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="endArrow=classic;dashed=1;html=1;" edge="1" parent="1" source="api" target="check">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="loose" style="endArrow=classic;html=1;" edge="1" parent="1" source="api">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="500" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="note" value="Retries: 3&lt;br&gt;Timeout: 5s" style="text;html=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="300" width="120" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
