<mxfile host="app.diagrams.net">
  <diagram id="c1" name="Platform">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="edge-lane" value="Edge" style="swimlane;startSize=24;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="cdn" value="CDN" style="rounded=1;" vertex="1" parent="edge-lane">
          <mxGeometry x="60" y="60" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="lb" value="Load balancer" style="rounded=1;" vertex="1" parent="edge-lane">
          <mxGeometry x="60" y="180" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="core-group" value="Core" style="container=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="300" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="App" style="rounded=1;" vertex="1" parent="core-group">
          <mxGeometry x="60" y="60" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="inner" value="Inner" style="container=1;" vertex="1" parent="core-group">
          <mxGeometry x="40" y="160" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cache" value="Cache" style="shape=cylinder3;" vertex="1" parent="inner">
          <mxGeometry x="40" y="20" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="w1" value="" style="endArrow=classic;" edge="1" parent="1" source="cdn" target="lb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="w2" value="" style="endArrow=classic;" edge="1" parent="1" source="lb" target="app">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="w3" value="" style="endArrow=classic;" edge="1" parent="1" source="app" target="cache">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="w4" value="" style="endArrow=classic;" edge="1" parent="1" source="edge-lane" target="app">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
