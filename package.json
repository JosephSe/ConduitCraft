{
  "name": "conduitcraft",
  "version": "3.0.0",
  "description": "ConduitCraft — Open-source interactive architecture diagramming studio with animated traffic and scenarios. Build from scratch on a blank canvas or compile Mermaid (.mmd) and Blueprint (.md) files into animated, simulation-ready architecture views.",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "type": "module",
  "keywords": [
    "architecture-diagram",
    "mermaid",
    "flowchart",
    "telemetry",
    "diagram-editor",
    "drawio",
    "blueprint",
    "svg-animation"
  ],
  "scripts": {
    "dev": "vite --port 5180",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4180",
    "check:size": "node tools/checkBundleSize.mjs",
    "test:e2e": "playwright test",
    "test:e2e:quick": "playwright test --project=chromium --grep @quick",
    "conduitcraft": "node --experimental-strip-types --import ./tests/register-ts.mjs tools/conduitcraft.ts",
    "test": "node --experimental-strip-types --import ./tests/register-ts.mjs --test tests/*.test.ts"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/js-yaml": "^4.0.9",
    "elkjs": "^0.12.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
