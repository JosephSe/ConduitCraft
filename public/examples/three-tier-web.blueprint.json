    "simulations": [
      {
        "id": "sim-cache-read",
        "name": "Read Request (Cache Hit)",
        "tone": "emerald",
        "steps": [
          {
            "id": "s1",
            "nodes": ["client", "cdn-waf"],
            "tone": "blue",
            "label": "EDGE LOOKUP",
            "trace": "Client sends HTTPS request to the Cloudflare CDN edge."
          },
          {
            "id": "s2",
            "nodes": ["cdn-waf", "alb"],
            "tone": "violet",
            "label": "INGRESS ROUTE",
            "trace": "CDN bypasses static cache and forwards dynamic request to ALB."
          },
          {
            "id": "s3",
            "nodes": ["alb", "app-01"],
            "tone": "emerald",
            "label": "ROUND ROBIN",
            "trace": "ALB routes request to healthy worker App Service Alpha."
          },
          {
            "id": "s4",
            "nodes": ["app-01", "redis"],
            "tone": "amber",
            "label": "CACHE HIT (0.6ms)",
            "trace": "App queries Redis cache and receives an immediate hit without touching the database."
          },
          {
            "id": "s5",
            "nodes": ["app-01", "client"],
            "tone": "emerald",
            "label": "HTTP 200 OK",
            "trace": "Payload formatted as JSON and returned directly to the client."
          }
        ]
      },
      {
        "id": "sim-order-write",
        "name": "Order Checkout (Write Transaction)",
        "tone": "rose",
        "steps": [
          {
            "id": "w1",
            "nodes": ["client", "alb", "app-02"],
            "tone": "blue",
            "label": "CHECKOUT POST",
            "trace": "User submits shopping cart checkout via HTTPS POST."
          },
          {
            "id": "w2",
            "nodes": ["app-02", "pg-primary"],
            "tone": "rose",
            "label": "ACID COMMIT",
            "trace": "App Service Beta writes transaction to PostgreSQL Primary with serializable isolation."
          },
          {
            "id": "w3",
            "nodes": ["pg-primary", "pg-replica"],
            "tone": "rose",
            "label": "WAL STREAM",
            "trace": "PostgreSQL streams write-ahead log records to read replica asynchronously."
          }
        ]
      }
    ]
