            "title": "Stateless Compute",
            "text": "App instances carry no state. All sessions are stored in the Redis cluster."
          },
          {
            "title": "Read Offload",
            "text": "Read-heavy queries route to the streaming replica, protecting primary write capacity."
          },
          {
            "title": "Failover",
            "text": "Automated orchestrator promotes read replica to primary in under 30 seconds."
          }
        ]
      }
